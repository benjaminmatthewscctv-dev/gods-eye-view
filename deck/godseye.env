# God's Eye View on the cyberdeck - read by setup.sh into ~/gods-eye-view/.env and by vite.deck.config.mjs.
# Keyless by default: the 2D Esri/OSM basemap, OpenSky flights, USGS quakes, OSRM routes, Photon/Nominatim geocoding.
# all interfaces: the phone (DeckD) renders the globe itself from the Pi's address; the MCP and key-setup routes stay loopback-only by their own checks
HOST=0.0.0.0
PORT=4173
# the cyberdeck window (chromium app at :8130) frames the embed page; nothing else may
GEV_EMBED_FRAME_ANCESTORS=*
# names the Pi answers to (IP addresses are always accepted)
GEV_ALLOWED_HOSTS=deckhub,deckhub.local,cyberdeck,cyberdeck.local
# the HUD caption comes from BIMO's mind on the PC (over this Pi's Tailscale link) instead of OpenAI
DECK_MIND_URL=http://100.101.188.108:8121
# traffic cameras: ALDOT's ALGO Traffic pack (deck/aldot_cameras.py writes it; setup.sh and every service start refresh it)
CCTV_SOURCES_FILE=/home/techup-dev0/godseye/cctv_sources.aldot.json
# optional upstream keys (leave empty to stay keyless): photoreal 3D tiles, Google Places, ships, fires, traffic
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
